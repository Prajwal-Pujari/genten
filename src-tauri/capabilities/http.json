{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-custom",
  "windows": ["*"],
  "permissions": [
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    }
  ]
}
